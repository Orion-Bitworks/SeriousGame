    m_Metadata:
      m_Items: []
  - m_Id: 5391757701120
    m_Localized: "Eliminar Pe\xE7es"
    m_Metadata:
      m_Items: []
  - m_Id: 3443709014016
    m_Localized: Objectiu
    m_Metadata:
      m_Items: []
  - m_Id: 3186048724992
    m_Localized: "Conecta les peces correctament per fer que el cor pugui comen\xE7ar
      a funcionar"
    m_Metadata:
      m_Items: []
  - m_Id: 4036821348352
    m_Localized: Moure peces
    m_Metadata:
      m_Items: []
  - m_Id: 4039316959232
    m_Localized: "Fer click i arrossegar les peces per poder moureles. Utilitza la
      roda del ratol\xED per apropar-la o allunyar-la"
    m_Metadata:
      m_Items: []
  - m_Id: 4040797548544
    m_Localized: "Mantenir Click - Roda Ratol\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 5106805075968
    m_Localized: Separar peces
    m_Metadata:
      m_Items: []
  - m_Id: 5109225189376
    m_Localized: "ESPAI + Click una pe\xE7a i arrosegala a una certa distancia per
      poder separar-la del grup"
    m_Metadata:
      m_Items: []
  - m_Id: 5394886651904
    m_Localized: "Click + SUPR per eliminar una pe\xE7a. Per\xF2 ves amb compte,
      si fas click en un grup, s'eliminen totes les peces!"
    m_Metadata:
      m_Items: []
