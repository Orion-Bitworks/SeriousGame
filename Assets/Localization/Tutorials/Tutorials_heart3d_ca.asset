  - m_Id: 5110579949568
    m_Localized: ESPAI + Mantenir Click
    m_Metadata:
      m_Items: []
  - m_Id: 4417118892032
    m_Localized: 'R + Mantenir Click Dret/ Esquerre '
    m_Metadata:
      m_Items: []
  - m_Id: 4414803636224
    m_Localized: "R + Click Esquerre per rotar la pe\xE7a\nR + Click Dret per rotar
